// @METADATA:name        = BEB-protocol
// @METADATA:description = Binary Exponential Backoff (BEB) protocol
// 3 hosts competing for shared communication line
// @METADATA:reference   = None
// @METADATA:criterion   = line_seized
// @METADATA:expected    = unknown
// @METADATA:tags        = LLM-generated (source: https://qcomp.org/benchmarks/#beb)

// 
// N = max attempts before giving up (instantiate N=4)
// Reference: PRISM/JANI benchmark beb-3-4

// Host local state: na=attempts, ev=backoff window, wt=wait time
// Initial: ev=2, wt=0, na=0 for all hosts

na0 := 0; ev0 := 2; wt0 := 0;   // Host 0
na1 := 0; ev1 := 2; wt1 := 0;   // Host 1
na2 := 0; ev2 := 2; wt2 := 0;   // Host 2

cr          := 0;
line_seized := 0;
gave_up     := 0;

// Run until line seized or all gave up
while (line_seized = 0 && gave_up = 0) do

    // --- TICK phase: each host either waits or attempts ---
    cr := 0;

    // Host 0: if waiting, decrement; else attempt (increment cr)
    if (wt0 > 0) then
        wt0 := wt0 - 1;
    else
        // cr = min(2, cr+1)
        if (cr + 1 < 2) then cr := cr + 1; else cr := 2; end
        na0 := na0 + 1;
    end

    // Host 1
    if (wt1 > 0) then
        wt1 := wt1 - 1;
    else
        if (cr + 1 < 2) then cr := cr + 1; else cr := 2; end
        na1 := na1 + 1;
    end

    // Host 2
    if (wt2 > 0) then
        wt2 := wt2 - 1;
    else
        if (cr + 1 < 2) then cr := cr + 1; else cr := 2; end
        na2 := na2 + 1;
    end

    // --- TACK phase: resolve outcome ---

    // Line seized if exactly one host attempted (cr=1)
    if (cr = 1) then
        line_seized := 1;
    else
        // Collision or no attempt — apply backoff
        // Host 0 backoff if it attempted (wt was 0)
        if (wt0 = 0 && cr != 1) then
            if (na0 >= 4) then
                gave_up := 1;
            else
                // Sample wt from [0, ev0-1]
                // ev0 in {2,4} -> max wt = ev0-1 in {1,3}
                if (ev0 = 2) then
                    wt0 :~ unif[0, 1];
                else
                    wt0 :~ unif[0, 3];
                end
                // Double ev, cap at 4
                if (ev0 * 2 < 4) then ev0 := ev0 * 2; else ev0 := 4; end
            end
        else
            skip;
        end

        // Host 1 backoff
        if (wt1 = 0 && cr != 1) then
            if (na1 >= 4) then
                gave_up := 1;
            else
                if (ev1 = 2) then
                    wt1 :~ unif[0, 1];
                else
                    wt1 :~ unif[0, 3];
                end
                if (ev1 * 2 < 4) then ev1 := ev1 * 2; else ev1 := 4; end
            end
        else
            skip;
        end

        // Host 2 backoff
        if (wt2 = 0 && cr != 1) then
            if (na2 >= 4) then
                gave_up := 1;
            else
                if (ev2 = 2) then
                    wt2 :~ unif[0, 3];
                else
                    wt2 :~ unif[0, 3];
                end
                if (ev2 * 2 < 4) then ev2 := ev2 * 2; else ev2 := 4; end
            end
        else
            skip;
        end
    end

end

observe(line_seized = 1);
return line_seized;