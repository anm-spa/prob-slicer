// @METADATA:name        = prodigy_evt_invariants_skip_sequential_loops
// @METADATA:description = Translated from Prodigy pGCL: evt_invariants/skip_sequential_loops.pgcl
// @METADATA:reference   = LKlinke/Prodigy (github.com/LKlinke/Prodigy)
// @METADATA:criterion   = c
// @METADATA:expected    = unknown
// @METADATA:tags        = prodigy translated evt_invariants

x := 1;
c := 0;
while (x = 1) do
  _coin :~ unif[0, 1];
  if (_coin <= 1 / 2) then
    c := c + 1;
  else
    x := 0;
  end
end
while (c > 0) do
  _coin :~ unif[0, 1];
  if (_coin <= 1 / 2) then
    c := c - 1;
  else
    c := c + 1;
  end
end
return c;