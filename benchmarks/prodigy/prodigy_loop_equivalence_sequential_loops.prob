while (0 < n) do
  tmp :~ unif[1, 6];
  m := m + tmp;
  tmp := 0;
  n := n - 1;
end
while (m > 0) do
  _coin :~ unif[0, 1];
  if (_coin <= 1 / 2) then
    m := m + 1;
  else
    m := m - 1;
  end
  c := c + 1;
  tmp := 0;
end
return tmp;