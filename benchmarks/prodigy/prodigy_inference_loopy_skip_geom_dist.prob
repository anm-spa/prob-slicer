// @METADATA:tags        = prodigy translated inference

x := 1;
c := 0;
while (! ( x = 0 )) do
  _coin :~ unif[0, 1];
  if (_coin <= 1 / 2) then
    skip;
  else
    x := 0;
  end
  c := c + 1;
end
return c;