a :~ unif[1, 10];
b :~ unif[1, 10];
x1 := 5;
y1 := 3 * x1 + 7;
x2 := 3;
y2 := 3 * x2 + 7;
observe(y1 = a * x1 + b);
observe(y2 = a * x2 + b);
return y2;