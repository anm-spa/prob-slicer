// @METADATA:name        = prodigy_evt_invariants_faulty_decrement
// @METADATA:description = Translated from Prodigy pGCL: evt_invariants/faulty_decrement.pgcl
// @METADATA:reference   = LKlinke/Prodigy (github.com/LKlinke/Prodigy)
// @METADATA:criterion   = x
// @METADATA:expected    = unknown
// @METADATA:tags        = prodigy translated evt_invariants

x :~ unif[0, 1];
while (x > 0) do
  _coin :~ unif[0, 1];
  if (_coin <= 1 / 2) then
    skip;
  else
    x := x - 1;
  end
end
return x;