// @METADATA:tags        = prodigy translated inference

while (c > 0) do
  _coin :~ unif[0, 1];
  if (_coin <= 1 / 2) then
    m := m + 1;
  else
    n := n + 1;
  end
  c := c - 1;
  tmp := 0;
end
observe(m * n > 20);
return tmp;