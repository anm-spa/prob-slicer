// @METADATA:name        = prodigy_evt_invariants_cond_and
// @METADATA:description = Translated from Prodigy pGCL: evt_invariants/cond_and.pgcl
// @METADATA:reference   = LKlinke/Prodigy (github.com/LKlinke/Prodigy)
// @METADATA:criterion   = m
// @METADATA:expected    = unknown
// @METADATA:tags        = prodigy translated evt_invariants

while (( 0 < n && 0 < m )) do
  _coin :~ unif[0, 1];
  if (_coin <= 1 / 2) then
    n := n - 1;
  else
    m := m - 1;
  end
end
return m;