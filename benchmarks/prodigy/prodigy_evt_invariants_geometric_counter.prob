// @METADATA:name        = prodigy_evt_invariants_geometric_counter
// @METADATA:description = Translated from Prodigy pGCL: evt_invariants/geometric_counter.pgcl
// @METADATA:reference   = LKlinke/Prodigy (github.com/LKlinke/Prodigy)
// @METADATA:criterion   = c
// @METADATA:expected    = unknown
// @METADATA:tags        = prodigy translated evt_invariants

x := 1;
while (x = 1) do
  _coin :~ unif[0, 1];
  if (_coin <= 1 / 2) then
    x := 0;
  else
    c := c + 1;
  end
end
return c;