// @METADATA:name        = prodigy_loop_equivalence_random_walk
// @METADATA:description = Translated from Prodigy pGCL: loop_equivalence/random_walk.pgcl
// @METADATA:reference   = LKlinke/Prodigy (github.com/LKlinke/Prodigy)
// @METADATA:criterion   = tmp
// @METADATA:expected    = unknown
// @METADATA:tags        = prodigy translated loop_equivalence

while (s > 0) do
  _coin :~ unif[0, 1];
  if (_coin <= 1 / 2) then
    s := s + 1;
  else
    s := s - 1;
  end
  c := c + 1;
  tmp := 0;
end
return tmp;