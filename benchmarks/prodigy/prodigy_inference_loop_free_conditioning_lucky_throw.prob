// @METADATA:tags        = prodigy translated inference

sum :~ unif[4, 24];
die :~ unif[1, 6];
if (die = 6) then
  lucky_throw := 1;
else
  skip;
end
hand := hand + die;
observe(hand = sum);
return hand;