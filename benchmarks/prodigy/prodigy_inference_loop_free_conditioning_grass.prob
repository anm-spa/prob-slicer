// @METADATA:name        = prodigy_inference_loop_free_conditioning_grass
// @METADATA:description = Translated from Prodigy pGCL: inference/loop_free/conditioning/grass.pgcl
// @METADATA:reference   = LKlinke/Prodigy (github.com/LKlinke/Prodigy)
// @METADATA:criterion   = wetGrass
// @METADATA:expected    = unknown
// @METADATA:tags        = prodigy translated inference

cloudy :~ bernoulli(1 / 2);
if (cloudy = 1) then
  rain :~ bernoulli(8 / 10);
  sprinkler :~ bernoulli(1 / 10);
else
  rain :~ bernoulli(2 / 10);
  sprinkler :~ bernoulli(5 / 10);
end
temp1 :~ bernoulli(7 / 10);
if (temp1 = 1 && rain = 1) then
  wetRoof := 1;
else
  skip;
end
temp2 :~ bernoulli(9 / 10);
temp3 :~ bernoulli(9 / 10);
if (( temp2 = 1 && rain = 1 ) || ( temp3 = 1 && sprinkler = 1 )) then
  wetGrass := 1;
else
  wetGrass := 0;
end
observe(wetGrass = 1);
return wetGrass;