// @METADATA:tags        = prodigy translated inference

evidence :~ unif[0, 1];
coin := 0;
if (evidence = 1) then
  coin1 :~ unif[0, 1];
  observe(coin1 = 1);
  coin := coin1;
else
  coin :~ unif[0, 1];
end
return coin;