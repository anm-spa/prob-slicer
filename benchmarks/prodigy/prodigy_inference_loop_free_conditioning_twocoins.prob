// @METADATA:reference   = LKlinke/Prodigy (github.com/LKlinke/Prodigy)
// @METADATA:criterion   = firstCoin
// @METADATA:expected    = unknown
// @METADATA:tags        = prodigy translated inference

firstCoin :~ bernoulli(1 / 2);
secondCoin :~ bernoulli(1 / 2);
if (firstCoin = 1 && secondCoin = 1) then
  bothHeads := 1;
else
  bothHeads := 0;
end
observe(bothHeads = 0);
return firstCoin;