n0 :~ bernoulli(1 / 2);
n4 :~ bernoulli(1 / 2);
if (n0 = 1) then
  n1 :~ bernoulli(4 / 5);
  n21 :~ bernoulli(4 / 5);
else
  n1 :~ bernoulli(1 / 10);
  n21 :~ bernoulli(1 / 10);
end
if (n4 = 1) then
  n22 :~ bernoulli(4 / 5);
  n33 :~ bernoulli(4 / 5);
else
  n22 :~ bernoulli(1 / 10);
  n33 :~ bernoulli(1 / 10);
end
if (n21 = 1 || n22 = 1) then
  n2 := 1;
else
  skip;
end
if (n1 = 1) then
  n31 :~ bernoulli(4 / 5);
else
  n31 :~ bernoulli(1 / 10);
end
if (n2 = 1) then
  n32 :~ bernoulli(4 / 5);
else
  n32 :~ bernoulli(1 / 10);
end
if (n31 = 1 || n32 = 1 || n33 = 1) then
  n3 := 1;
else
  skip;
end
return n3;