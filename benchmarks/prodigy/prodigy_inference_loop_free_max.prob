a :~ bernoulli(1 / 2);
b :~ bernoulli(1 / 2);
if (a > b) then
  res := a;
else
  res := b;
end
a := 0;
b := 0;
if (res = 1) then
  val := 1;
else
  val := 0;
end
return val;