while (s > 0 && f < 5) do
  _coin :~ unif[0, 1];
  if (_coin <= 1 / 100) then
    observe(s < 10);
    f := f + 1;
  else
    f := 0;
    s := s - 1;
  end
  h := 0;
  t := 0;
end
return t;