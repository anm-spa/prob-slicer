// @METADATA:name        = prodigy_loop_equivalence_condand
// @METADATA:description = Translated from Prodigy pGCL: loop_equivalence/condand.pgcl
// @METADATA:reference   = LKlinke/Prodigy (github.com/LKlinke/Prodigy)
// @METADATA:criterion   = m
// @METADATA:expected    = unknown
// @METADATA:tags        = prodigy translated loop_equivalence

while (( 0 < n && 0 < m )) do
  _coin :~ unif[0, 1];
  if (_coin <= 1 / 2) then
    n := n - 1;
  else
    m := m - 1;
  end
end
return m;