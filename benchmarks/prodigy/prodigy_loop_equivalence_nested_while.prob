while (x > 0) do
  y := 1;
  while (y = 1) do
    _coin :~ unif[0, 1];
    if (_coin <= 1 / 2) then
      y := 0;
    else
      x := x + 1;
    end
    temp := 0;
  end
  x := x - 1;
  c := c + 1;
end
return c;