// @METADATA:name        = prodigy_inference_loop_free_prob_collatz
// @METADATA:description = Translated from Prodigy pGCL: inference/loop_free/prob_collatz.pgcl
// @METADATA:reference   = LKlinke/Prodigy (github.com/LKlinke/Prodigy)
// @METADATA:criterion   = x
// @METADATA:expected    = unknown
// @METADATA:tags        = prodigy translated inference

x :~ unif[0, 1];
if (x % 2 = 0) then
  _coin :~ unif[0, 1];
  if (_coin <= 1 / 10) then
    x := 3 * x + 1;
  else
    x := 1 / 2 * x;
  end
else
  x := 3 * x + 1;
end
return x;