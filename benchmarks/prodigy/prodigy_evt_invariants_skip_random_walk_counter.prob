// @METADATA:name        = prodigy_evt_invariants_skip_random_walk_counter
// @METADATA:description = Translated from Prodigy pGCL: evt_invariants/skip_random_walk_counter.pgcl
// @METADATA:reference   = LKlinke/Prodigy (github.com/LKlinke/Prodigy)
// @METADATA:criterion   = c
// @METADATA:expected    = unknown
// @METADATA:tags        = prodigy translated evt_invariants

x := 1;
c := 0;
while (x > 0) do
  _coin :~ unif[0, 1];
  if (_coin <= 1 / 2) then
    x := x - 1;
  else
    x := x + 1;
  end
  c := c + 1;
end
return c;