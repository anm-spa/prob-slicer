while (! ( ( b1 = 0 ) && ( b2 = 0 ) )) do
  b1 :~ bernoulli(1 - p);
  b2 :~ bernoulli(1 - p);
  observe(( b1 = 0 && b3 = 0 ) || ( b1 = 1 && b3 = 1 ) || ( b2 = 0 && b4 = 0 ) || ( b2 = 1 && b4 = 1 ));
  b3 := b1;
  b4 := b2;
  i := i + 1;
  temp := 0;
end
return temp;