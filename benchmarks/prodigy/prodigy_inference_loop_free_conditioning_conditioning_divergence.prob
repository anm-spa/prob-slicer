// @METADATA:description = Translated from Prodigy pGCL: inference/loop_free/conditioning/conditioning_divergence.pgcl
// @METADATA:reference   = LKlinke/Prodigy (github.com/LKlinke/Prodigy)
// @METADATA:criterion   = y
// @METADATA:expected    = unknown
// @METADATA:tags        = prodigy translated inference

_coin :~ unif[0, 1];
if (_coin <= 1 / 2) then
  while (true) do
    skip;
  end
else
  x :~ bernoulli(1 / 2);
  y :~ bernoulli(1 / 2);
  observe(x = 0 || y = 0);
end
return y;