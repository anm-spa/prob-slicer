// @METADATA:name        = hur_chess
// @METADATA:description = Chess skill rating from Hur et al. (2014) Table 1.
//                         TrueSkill-style model. Original: 77 players 2926
//                         games. Scaled to 4 players 5 games. Criterion:
//                         skills of 3 particular players (player 4 irrelevant).
// @METADATA:reference   = Hur Nori Rajamani Samuel (2014) Slicing
//                         Probabilistic Programs. PLDI 2014.
//                         TrueSkill: Dangauthier et al. (2007) NIPS
// @METADATA:criterion   = skill1
// @METADATA:expected    = skill4 and games involving only player4 sliced out;
//                         skill1 skill2 skill3 kept; games 1-3 kept via observe
// @METADATA:tags        = trueskill, bayesian, evaluation-benchmark,
//                         hur-pldi14, skill-rating, r-slicing

skill1     :~ unif[0, 10];
skill2     :~ unif[0, 10];
skill3     :~ unif[0, 10];
skill4     :~ unif[0, 10];
perf_noise :~ unif[-2, 2];
diff12     := skill1 - skill2 + perf_noise;
if diff12 > 0 then
    win12 := 1;
else
    win12 := 0;
end
observe(win12 = 1);
diff13 := skill1 - skill3 + perf_noise;
if diff13 > 0 then
    win13 := 1;
else
    win13 := 0;
end
observe(win13 = 0);
diff23 := skill2 - skill3 + perf_noise;
if diff23 > 0 then
    win23 := 1;
else
    win23 := 0;
end
observe(win23 = 1);
diff14 := skill1 - skill4 + perf_noise;
if diff14 > 0 then
    win14 := 1;
else
    win14 := 0;
end
observe(win14 = 1);
diff34 := skill3 - skill4 + perf_noise;
if diff34 > 0 then
    win34 := 1;
else
    win34 := 0;
end
observe(win34 = 0);
irrelevant := skill4 + 1;
return skill1;