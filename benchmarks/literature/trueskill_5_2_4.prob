// @METADATA:name        = trueskill_5_2_4
// @METADATA:description = TrueSkill tournament: 5 teams, 2 players/team, 4 matches
// @METADATA:reference   = Herbrich et al., TrueSkill (NeurIPS 2006)
// @METADATA:criterion   = s_1_1
// @METADATA:expected    = unknown
// @METADATA:tags        = generated probabilistic

// TrueSkill tournament: 5 teams, 2 players, 4 matches

// --- Player skills ---
s_1_1 :~ unif[0, 10];
s_2_1 :~ unif[0, 10];
s_3_1 :~ unif[0, 10];
s_3_2 :~ unif[0, 10];
s_4_1 :~ unif[0, 10];
s_5_1 :~ unif[0, 10];

// --- Team performances ---
perf_1 := s_1_1;
perf_2 := s_2_1;
perf_3 := s_3_1 + s_3_2;
perf_4 := s_4_1;
perf_5 := s_5_1;

// --- Match observations ---
noise_0 :~ unif[0, 1];
observe(perf_4 + noise_0 > perf_1);
noise_1 :~ unif[0, 1];
observe(perf_1 + noise_1 > perf_3);
noise_2 :~ unif[0, 1];
observe(perf_3 + noise_2 > perf_5);
noise_3 :~ unif[0, 1];
observe(perf_2 + noise_3 > perf_3);

// --- Query: skill of player 1 on team 1 ---
return s_1_1;