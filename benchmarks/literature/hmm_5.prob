// @METADATA:name        = hmm_5
// @METADATA:description = HMM with 5 time steps
// @METADATA:reference   = generated/hmm
// @METADATA:criterion   = x0
// @METADATA:expected    = unknown
// @METADATA:tags        = generated

x0 :~ unif[1, 4];
noise1 :~ unif[0, 1];
x1 := x0 + noise1;
y1 :~ unif[1, 4];
observe(y1 = x1);
noise2 :~ unif[0, 1];
x2 := x1 + noise2;
y2 :~ unif[1, 4];
observe(y2 = x2);
noise3 :~ unif[0, 1];
x3 := x2 + noise3;
y3 :~ unif[1, 4];
observe(y3 = x3);
noise4 :~ unif[0, 1];
x4 := x3 + noise4;
y4 :~ unif[1, 4];
observe(y4 = x4);
noise5 :~ unif[0, 1];
x5 := x4 + noise5;
y5 :~ unif[1, 4];
observe(y5 = x5);
return x5;