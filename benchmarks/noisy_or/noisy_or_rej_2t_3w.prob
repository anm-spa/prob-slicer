// @METADATA:name        = noisy_or_rej_2t_3w
// @METADATA:description = Noisy-OR topic model with rejection sampling loop: 2 topics, 3 words. Loop resamples until all word observations pass. NS keeps loop, NI removes it.
// @METADATA:reference   = Henrion (1987), Noisy-OR gates; BeanMachine PPLBench implementation
// @METADATA:criterion   = node_1
// @METADATA:expected    = ns_size > ni_size
// @METADATA:tags        = generated noisy_or rejection_sampling

// Noisy-OR Topic Model with Rejection Sampling Loop
// 2 topics, 3 words
// Loop resamples until all word observations pass
// NS keeps loop; NI removes it -> variant distinction
// Reference: Henrion (1987), BeanMachine PPLBench

_accepted := 0;
while (_accepted = 0) do

  // Root node (always active)
  node_0 := 1;
  
  // Topic nodes (latent)
  // Topic 1: parents = [(0, 1)]
  _acc_1 := 0;
  _acc_1 := _acc_1 + node_0 * 1;
  _coin_1 :~ unif[1, 1000];
  node_1 := 0;
  if (_acc_1 >= 1 && _coin_1 <= 632) then
      node_1 := 1;
  else
      skip;
  end
  
  // Topic 2: parents = [(0, 1)]
  _acc_2 := 0;
  _acc_2 := _acc_2 + node_0 * 1;
  _coin_2 :~ unif[1, 1000];
  node_2 := 0;
  if (_acc_2 >= 1 && _coin_2 <= 632) then
      node_2 := 1;
  else
      skip;
  end
  
  // Word nodes — check all observations
  _all_words_ok := 1;
  
  // Word 1: parents = [(1, 1)]
  _acc_w1 := 0;
  _acc_w1 := _acc_w1 + node_1 * 1;
  _coin_w1 :~ unif[1, 1000];
  _word_1 := 0;
  if (_acc_w1 >= 1 && _coin_w1 <= 632) then
      _word_1 := 1;
  else
      skip;
  end
  if (_word_1 = 0) then
      _all_words_ok := 0;
  else
      skip;
  end
  
  // Word 2: parents = [(1, 1), (2, 1)]
  _acc_w2 := 0;
  _acc_w2 := _acc_w2 + node_1 * 1;
  _acc_w2 := _acc_w2 + node_2 * 1;
  _coin_w2 :~ unif[1, 1000];
  _word_2 := 0;
  if (_acc_w2 >= 1 && _coin_w2 <= 632) then
      _word_2 := 1;
  else
      skip;
  end
  if (_acc_w2 >= 2 && _coin_w2 <= 865) then
      _word_2 := 1;
  else
      skip;
  end
  if (_word_2 = 0) then
      _all_words_ok := 0;
  else
      skip;
  end
  
  // Word 3: parents = [(1, 1)]
  _acc_w3 := 0;
  _acc_w3 := _acc_w3 + node_1 * 1;
  _coin_w3 :~ unif[1, 1000];
  _word_3 := 0;
  if (_acc_w3 >= 1 && _coin_w3 <= 632) then
      _word_3 := 1;
  else
      skip;
  end
  if (_word_3 = 0) then
      _all_words_ok := 0;
  else
      skip;
  end
  
  if (_all_words_ok = 1) then
      _accepted := 1;
  else
      skip;
  end
  
end

return node_1;