// @METADATA:name        = noisy_or_2t_3w
// @METADATA:description = Noisy-OR topic model: 2 topics, 3 words. Bernoulli approximated via unif[1,1000].
// @METADATA:reference   = Henrion (1987), Noisy-OR; BeanMachine PPLBench implementation
// @METADATA:criterion   = node_1
// @METADATA:expected    = unknown
// @METADATA:tags        = generated noisy_or bayesian_network

// Noisy-OR Topic Model
// 2 topics, 3 words
// Bernoulli(1-exp(-acc)) approximated via unif[1,1000]
// Reference: Henrion (1987), Noisy-OR gates

// Root node (always active)
node_0 := 1;

// Topic nodes (latent)
// Topic 1: parents = [(0, 1)]
_acc_1 := 0;
_acc_1 := _acc_1 + node_0 * 1;
_coin_1 :~ unif[1, 1000];
node_1 := 0;
if (_acc_1 >= 1 && _coin_1 <= 632) then
  node_1 := 1;
else
  skip;
end

// Topic 2: parents = [(0, 1)]
_acc_2 := 0;
_acc_2 := _acc_2 + node_0 * 1;
_coin_2 :~ unif[1, 1000];
node_2 := 0;
if (_acc_2 >= 1 && _coin_2 <= 632) then
  node_2 := 1;
else
  skip;
end

// Word nodes (observed active)
// Word 1: parents = [(1, 1)]
_acc_w1 := 0;
_acc_w1 := _acc_w1 + node_1 * 1;
_coin_w1 :~ unif[1, 1000];
_word_1 := 0;
if (_acc_w1 >= 1 && _coin_w1 <= 632) then
  _word_1 := 1;
else
  skip;
end
observe(_word_1 = 1);

// Word 2: parents = [(1, 1), (2, 1)]
_acc_w2 := 0;
_acc_w2 := _acc_w2 + node_1 * 1;
_acc_w2 := _acc_w2 + node_2 * 1;
_coin_w2 :~ unif[1, 1000];
_word_2 := 0;
if (_acc_w2 >= 1 && _coin_w2 <= 632) then
  _word_2 := 1;
else
  skip;
end
if (_acc_w2 >= 2 && _coin_w2 <= 865) then
  _word_2 := 1;
else
  skip;
end
observe(_word_2 = 1);

// Word 3: parents = [(1, 1)]
_acc_w3 := 0;
_acc_w3 := _acc_w3 + node_1 * 1;
_coin_w3 :~ unif[1, 1000];
_word_3 := 0;
if (_acc_w3 >= 1 && _coin_w3 <= 632) then
  _word_3 := 1;
else
  skip;
end
observe(_word_3 = 1);

return node_1;