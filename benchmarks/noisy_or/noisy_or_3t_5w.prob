// Noisy-OR Topic Model
// 3 topics, 5 words
// Bernoulli(1-exp(-acc)) approximated via unif[1,1000]
// Reference: Henrion (1987), Noisy-OR gates

// Root node (always active)
node_0 := 1;

// Topic nodes (latent)
// Topic 1: parents = [(0, 1)]
_acc_1 := 0;
_acc_1 := _acc_1 + node_0 * 1;
_coin_1 :~ unif[1, 1000];
node_1 := 0;
if (_acc_1 >= 1 && _coin_1 <= 632) then
  node_1 := 1;
else
  skip;
end

// Topic 2: parents = [(0, 1)]
