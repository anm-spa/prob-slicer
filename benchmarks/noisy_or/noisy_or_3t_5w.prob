// Word 5: parents = [(3, 1), (1, 1), (2, 1)]
_acc_w5 := 0;
_acc_w5 := _acc_w5 + node_3 * 1;
_acc_w5 := _acc_w5 + node_1 * 1;
_acc_w5 := _acc_w5 + node_2 * 1;
_coin_w5 :~ unif[1, 1000];
