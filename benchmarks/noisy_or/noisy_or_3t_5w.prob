_acc_w1 := _acc_w1 + node_2 * 1;
_coin_w1 :~ unif[1, 1000];
_word_1 := 0;
if (_acc_w1 >= 1 && _coin_w1 <= 632) then
  _word_1 := 1;
else
  skip;
end
if (_acc_w1 >= 2 && _coin_w1 <= 865) then
  _word_1 := 1;
else
  skip;
end
if (_acc_w1 >= 3 && _coin_w1 <= 950) then
  _word_1 := 1;
else
  skip;
end
observe(_word_1 = 1);

// Word 2: parents = [(1, 1)]
_acc_w2 := 0;
_acc_w2 := _acc_w2 + node_1 * 1;
_coin_w2 :~ unif[1, 1000];
_word_2 := 0;
if (_acc_w2 >= 1 && _coin_w2 <= 632) then
  _word_2 := 1;
