// @METADATA:name        = nids_ni_gap_3obs
// @METADATA:description = NIDS vs NI gap: 3 observe statements + nonterminating while. NI removes y_i observes, NIDS keeps them.
// @METADATA:reference   = generated/variant_distinction
// @METADATA:criterion   = x
// @METADATA:expected    = nids_size > ni_size
// @METADATA:tags        = generated variant_distinction nids_ni

x :~ unif[1, 4];
y0 :~ unif[1, 4];
observe(y0 = 2);
y1 :~ unif[1, 4];
observe(y1 = 2);
y2 :~ unif[1, 4];
observe(y2 = 2);
while (x = 4) do
  skip;
end
observe(x = 2);
return x;